---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import PrimaryNavigation from './PrimaryNavigation.astro';
---

<div class="site-identity">
	<Default><slot /></Default>
	<div class="desktop-navigation"><PrimaryNavigation /></div>
</div>

<style>
	.site-identity {
		display: flex;
		align-items: center;
		gap: clamp(0.5rem, 1.5vw, 1rem);
		min-width: 0;
	}

	.site-identity :global(.site-title) {
		flex: 0 1 auto;
		overflow: hidden;
	}

	.site-identity :global(.site-title span) {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.site-identity :global(.site-title img) {
		box-sizing: border-box;
		max-width: clamp(6rem, 14vw, 8.5rem);
		border-radius: 0.35rem;
		background: #fff;
		padding: 0.2rem 0.35rem;
	}

	.desktop-navigation {
		flex: none;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		padding-inline-start: clamp(0.35rem, 1vw, 0.7rem);
	}

	@media (max-width: 49.999rem) {
		.site-identity :global(.site-title img) {
			max-width: 6rem;
		}

		.desktop-navigation {
			display: none;
		}
	}
</style>
